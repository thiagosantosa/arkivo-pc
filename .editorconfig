# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Código nativo (Android/iOS) segue a convenção das plataformas.
[*.{kt,kts,java,gradle,swift,m,h,podspec}]
indent_size = 4

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
